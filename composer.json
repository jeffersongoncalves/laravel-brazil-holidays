{
    "name": "jeffersongoncalves/laravel-brazil-holidays",
    "description": "Brazilian national holidays for Laravel: holiday list per year, holiday and business day checks, and business day arithmetic.",
    "keywords": [
        "jeffersongoncalves",
        "laravel",
        "laravel-brazil-holidays",
        "brazil",
        "holidays",
        "feriados",
        "business-days",
        "dias-uteis"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-brazil-holidays",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "laravel/framework": "^12.61.1|^13.12.0",
        "spatie/laravel-package-tools": "^1.14.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7.4|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\BrazilHolidays\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\BrazilHolidays\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\BrazilHolidays\\BrazilHolidaysServiceProvider"
            ],
            "aliases": {
                "BrazilHolidays": "JeffersonGoncalves\\BrazilHolidays\\Facades\\BrazilHolidays"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
